    <string name="certificates_valid_explanation">Certifikát je v rámci uvedeného období platnosti.</string>
    <string name="certificates_expired_explanation">Android může nadále přijímat nainstalovanou aplikaci po vypršení jejího podepisovacího certifikátu. Porovnejte otisk s důvěryhodným zdrojem, pokud je aplikace nebo aktualizace neočekávaná.</string>
