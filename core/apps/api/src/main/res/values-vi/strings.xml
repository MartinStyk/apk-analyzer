    <string name="general_info_rationale_install_source_google_play">Ứng dụng này đã được tải xuống và cài đặt thông qua Google Play, nơi kiểm tra các ứng dụng trước khi phát hành chúng.</string>
    <string name="general_info_rationale_install_source_samsung_galaxy_store">Ứng dụng này đã được tải xuống và cài đặt thông qua Cửa hàng Galaxy của Samsung, cửa hàng ứng dụng của nhà sản xuất.</string>
    <string name="general_info_rationale_install_source_amazon_appstore">Ứng dụng này đã được tải xuống và cài đặt thông qua Cửa hàng Ứng dụng Amazon.</string>
    <string name="general_info_rationale_install_source_huawei_app_gallery">Ứng dụng này đã được tải xuống và cài đặt thông qua AppGallery của Huawei, cửa hàng ứng dụng của nhà sản xuất.</string>
    <string name="general_info_rationale_install_source_xiaomi_get_apps">Ứng dụng này đã được tải xuống và cài đặt thông qua cửa hàng GetApps của Xiaomi, cửa hàng ứng dụng của nhà sản xuất.</string>
    <string name="general_info_rationale_install_source_fdroid">Ứng dụng này đã được tải xuống và cài đặt thông qua F-Droid, một cửa hàng chỉ phân phối các ứng dụng được xây dựng từ mã nguồn mở công khai.</string>
    <string name="general_info_rationale_install_source_aurora_store">Ứng dụng này đã được tải xuống và cài đặt thông qua Aurora Store, một ứng dụng thay thế để duyệt và cài đặt các ứng dụng Google Play.</string>
    <string name="general_info_rationale_install_source_sideloaded">Ứng dụng này đã được cài đặt thủ công từ một tệp APK đã tải xuống thay vì thông qua một cửa hàng ứng dụng, vì vậy nó chưa trải qua quy trình xem xét của cửa hàng.</string>
    <string name="general_info_rationale_install_source_local_install">Ứng dụng này đã được cài đặt trực tiếp từ một máy tính kết nối, thường sử dụng một công cụ phát triển như ADB, thay vì thông qua một cửa hàng ứng dụng.</string>
    <string name="general_info_rationale_install_source_system">Ứng dụng này đã được cài đặt sẵn trên thiết bị như một phần của hệ điều hành hoặc phần mềm của nhà sản xuất.</string>
    <string name="general_info_rationale_install_source_unknown">Android không thể báo cáo nơi ứng dụng này được cài đặt từ đâu. Điều này có thể xảy ra sau khi khôi phục sao lưu thiết bị hoặc với một số trình cài đặt cụ thể của nhà sản xuất.</string>
