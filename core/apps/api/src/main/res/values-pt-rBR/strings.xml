    <string name="general_info_rationale_install_source_google_play">Este aplicativo foi baixado e instalado através do Google Play, que analisa aplicativos antes de publicá-los.</string>
    <string name="general_info_rationale_install_source_samsung_galaxy_store">Este aplicativo foi baixado e instalado através da Galaxy Store da Samsung, a loja de aplicativos própria do fabricante.</string>
    <string name="general_info_rationale_install_source_amazon_appstore">Este aplicativo foi baixado e instalado através da Amazon Appstore.</string>
    <string name="general_info_rationale_install_source_huawei_app_gallery">Este aplicativo foi baixado e instalado através da AppGallery da Huawei, a loja de aplicativos própria do fabricante.</string>
    <string name="general_info_rationale_install_source_xiaomi_get_apps">Este aplicativo foi baixado e instalado através da loja GetApps da Xiaomi, a loja de aplicativos própria do fabricante.</string>
    <string name="general_info_rationale_install_source_fdroid">Este aplicativo foi baixado e instalado através do F-Droid, uma loja que distribui apenas aplicativos construídos a partir de código público e de código aberto.</string>
    <string name="general_info_rationale_install_source_aurora_store">Este aplicativo foi baixado e instalado através da Aurora Store, um aplicativo alternativo para navegar e instalar aplicativos do Google Play.</string>
    <string name="general_info_rationale_install_source_sideloaded">Este aplicativo foi instalado manualmente a partir de um arquivo APK baixado, em vez de através de uma loja de aplicativos, portanto, não passou pelo processo de revisão da loja.</string>
    <string name="general_info_rationale_install_source_local_install">Este aplicativo foi instalado diretamente de um computador conectado, normalmente usando uma ferramenta de desenvolvedor como ADB, em vez de através de uma loja de aplicativos.</string>
    <string name="general_info_rationale_install_source_system">Este aplicativo veio pré-instalado no dispositivo como parte do sistema operacional ou software do fabricante.</string>
    <string name="general_info_rationale_install_source_unknown">O Android não conseguiu relatar de onde este aplicativo foi instalado. Isso pode acontecer após a restauração de um backup do dispositivo ou com alguns instaladores específicos do fabricante.</string>
