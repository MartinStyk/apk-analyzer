    <string name="general_info_rationale_install_source_google_play">Ta aplikacja została pobrana i zainstalowana przez Google Play, który sprawdza aplikacje przed ich publikacją.</string>
    <string name="general_info_rationale_install_source_samsung_galaxy_store">Ta aplikacja została pobrana i zainstalowana przez Galaxy Store firmy Samsung, własny sklep z aplikacjami producenta.</string>
    <string name="general_info_rationale_install_source_amazon_appstore">Ta aplikacja została pobrana i zainstalowana przez Amazon Appstore.</string>
    <string name="general_info_rationale_install_source_huawei_app_gallery">Ta aplikacja została pobrana i zainstalowana przez AppGallery firmy Huawei, własny sklep z aplikacjami producenta.</string>
    <string name="general_info_rationale_install_source_xiaomi_get_apps">Ta aplikacja została pobrana i zainstalowana przez sklep GetApps firmy Xiaomi, własny sklep z aplikacjami producenta.</string>
    <string name="general_info_rationale_install_source_fdroid">Ta aplikacja została pobrana i zainstalowana przez F-Droid, sklep, który dystrybuuje tylko aplikacje zbudowane z publicznego, otwartego kodu.</string>
    <string name="general_info_rationale_install_source_aurora_store">Ta aplikacja została pobrana i zainstalowana przez Aurora Store, alternatywną aplikację do przeglądania i instalowania aplikacji z Google Play.</string>
    <string name="general_info_rationale_install_source_sideloaded">Ta aplikacja została zainstalowana ręcznie z pobranego pliku APK zamiast przez sklep z aplikacjami, więc nie przeszła procesu przeglądu sklepu.</string>
    <string name="general_info_rationale_install_source_local_install">Ta aplikacja została zainstalowana bezpośrednio z podłączonego komputera, zazwyczaj przy użyciu narzędzia deweloperskiego, takiego jak ADB, zamiast przez sklep z aplikacjami.</string>
    <string name="general_info_rationale_install_source_system">Ta aplikacja była wstępnie zainstalowana na urządzeniu jako część systemu operacyjnego lub oprogramowania producenta.</string>
    <string name="general_info_rationale_install_source_unknown">Android nie mógł zgłosić, skąd ta aplikacja została zainstalowana. Może się to zdarzyć po przywróceniu kopii zapasowej urządzenia lub z niektórymi instalatorami specyficznymi dla producenta.</string>
