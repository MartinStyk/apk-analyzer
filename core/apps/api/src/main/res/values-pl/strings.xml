    <string name="certificates_algorithm_strong">Silny</string>
    <string name="certificates_algorithm_weak">Słaby</string>
    <string name="certificates_algorithm_unknown">Nieznana siła</string>
    <string name="certificates_algorithm_strong_explanation">%1$s używa SHA-256 lub silniejszego skrótu. Nie jest znany żaden praktyczny atak kolizyjny, chociaż ogólne bezpieczeństwo zależy również od typu i rozmiaru klucza podpisu.</string>
    <string name="certificates_algorithm_sha1_explanation">%1$s używa SHA-1. SHA-1 nie jest już odporny na kolizje, więc atakujący może stworzyć różne dane z tym samym skrótem. Nowe certyfikaty podpisu powinny używać SHA-256 lub silniejszego.</string>
    <string name="certificates_algorithm_md5_explanation">%1$s używa MD5. MD5 nie jest odporny na kolizje i jest niebezpieczny dla certyfikatów podpisu. Nowe certyfikaty podpisu powinny używać SHA-256 lub silniejszego.</string>
    <string name="certificates_algorithm_md2_explanation">%1$s używa MD2. MD2 jest przestarzały i podatny na praktyczne ataki, więc jest niebezpieczny dla certyfikatów podpisu. Nowe certyfikaty podpisu powinny używać SHA-256 lub silniejszego.</string>
    <string name="certificates_algorithm_unknown_explanation">Siły %1$s nie można ocenić na podstawie nazwy algorytmu. Typ i rozmiar klucza mogą również wpływać na jego bezpieczeństwo.</string>
