    <string name="general_info_rationale_application_name">The user-visible label of the app, as shown on the home screen and in the app drawer.</string>
    <string name="general_info_rationale_package_name">The unique identifier for this app on the device. No two apps can share the same package name.</string>
    <string name="general_info_rationale_process_name">The name of the operating system process the app runs in. By default, it matches the package name.</string>
    <string name="general_info_rationale_uid">The unique identifier assigned to this app by the Android system. It determines the app\'s access to system resources and file permissions.</string>
    <string name="general_info_rationale_shared_user_id">This app declares that it runs under a shared identity with other apps signed by the same key. Apps sharing this identity can access each other\'s data and permissions as if they were one app.</string>
    <string name="general_info_rationale_description">An optional summary provided by the app developer in the manifest.</string>
    <string name="general_info_rationale_version_name">The human-readable version string displayed to users, such as \"2.5.1\" or \"Beta 3\".</string>
    <string name="general_info_rationale_version_code">An internal integer that increases with every release. The system uses it to determine whether one version is newer than another.</string>
    <string name="general_info_rationale_min_sdk">The lowest Android API level this app supports. Devices running an older version cannot install it.</string>
    <string name="general_info_rationale_target_sdk">The API level the app was designed and tested for. It tells the system which compatibility behaviors to apply.</string>
    <string name="general_info_rationale_debug_access_enabled">Development tools can inspect and control this app while it runs. This helps during testing, but published apps usually turn it off because anyone with debugging access to the device gets extra access to the app.</string>
    <string name="general_info_rationale_debug_access_disabled">Development tools cannot attach to this app using Android\'s normal app-debugging access.</string>
    <string name="general_info_rationale_backup_allowed">Android may include this app\'s data in backups or move it to another device. The exact data depends on the app\'s backup rules and the Android version.</string>
    <string name="general_info_rationale_backup_blocked">The app disables Android cloud backup. Device-to-device transfer may still vary by Android version and device manufacturer.</string>
    <string name="general_info_rationale_cleartext_allowed">The app\'s general manifest setting allows network connections without encryption. Custom network security rules can override this setting. This does not prove the app sends unencrypted data.</string>
    <string name="general_info_rationale_cleartext_blocked">The app\'s general manifest setting disables network connections without encryption. Custom network security rules and some networking libraries can behave differently.</string>
    <string name="general_info_rationale_app_type">Whether the app is a pre-installed system app or a user-installed app. System apps have elevated privileges and cannot be fully uninstalled.</string>
    <string name="general_info_rationale_install_source_google_play">This app was downloaded and installed through Google Play, which screens apps before publishing them.</string>
    <string name="general_info_rationale_install_source_samsung_galaxy_store">This app was downloaded and installed through Samsung\'s Galaxy Store, the manufacturer\'s own app store.</string>
    <string name="general_info_rationale_install_source_amazon_appstore">This app was downloaded and installed through the Amazon Appstore.</string>
    <string name="general_info_rationale_install_source_huawei_app_gallery">This app was downloaded and installed through Huawei\'s AppGallery, the manufacturer\'s own app store.</string>
    <string name="general_info_rationale_install_source_xiaomi_get_apps">This app was downloaded and installed through Xiaomi\'s GetApps store, the manufacturer\'s own app store.</string>
    <string name="general_info_rationale_install_source_fdroid">This app was downloaded and installed through F-Droid, a store that only distributes apps built from public, open-source code.</string>
    <string name="general_info_rationale_install_source_aurora_store">This app was downloaded and installed through Aurora Store, an alternative app for browsing and installing Google Play apps.</string>
    <string name="general_info_rationale_install_source_sideloaded">This app was installed manually from a downloaded APK file rather than through an app store, so it hasn\'t gone through a store\'s review process.</string>
    <string name="general_info_rationale_install_source_local_install">This app was installed directly from a connected computer, typically using a developer tool such as ADB, rather than through an app store.</string>
    <string name="general_info_rationale_install_source_system">This app came preinstalled on the device as part of the operating system or manufacturer software.</string>
    <string name="general_info_rationale_install_source_unknown">Android could not report where this app was installed from. This can happen after restoring a device backup or with some manufacturer-specific installers.</string>
    <string name="general_info_rationale_installer_package">The package name of the app that performed the installation, such as \"com.android.vending\" for Google Play.</string>
    <string name="general_info_rationale_install_initiator">The app that started the installation, such as a browser or file manager for a sideloaded app, or an app store for a store install. This can differ from the installer package above.</string>
    <string name="general_info_rationale_install_originator">The package that provided the APK file, when Android reports it separately from the app that started the installation. Most installs leave this blank.</string>
    <string name="general_info_rationale_first_installed">The date and time this app was first installed on the device.</string>
    <string name="general_info_rationale_last_updated">The date and time of the most recent update to this app.</string>
    <string name="general_info_rationale_last_used">The approximate date and time this app was last opened by the user.</string>
    <string name="general_info_rationale_apk_directory">The file system path where the APK file is stored on the device.</string>
    <string name="general_info_rationale_data_directory">The file system path where the app stores its private data, databases, and shared preferences.</string>
    <string name="general_info_rationale_install_location">The preferred storage location declared by the developer — internal storage, external storage, or automatic.</string>
    <string name="general_info_rationale_apk_size">The combined size of the installed APK files on disk, excluding app data, caches, and runtime-generated files. Most apps installed from Google Play are split into a base APK plus additional APKs for your device\'s language and screen density; this total covers all of them.</string>
    <string name="general_info_rationale_total_size">The combined size of the APK, app data, and cached files. Requires usage access permission.</string>
    <string name="general_info_rationale_native_library_abis">The processor types this app includes compiled native code for, read from the APK\'s own files rather than what this device reports.</string>
