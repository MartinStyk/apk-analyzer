    <string name="general_info_rationale_application_name">Label yang terlihat oleh pengguna dari aplikasi, seperti yang ditampilkan di layar beranda dan di laci aplikasi.</string>
    <string name="general_info_rationale_package_name">Pengidentifikasi unik untuk aplikasi ini di perangkat. Tidak ada dua aplikasi yang dapat berbagi nama paket yang sama.</string>
    <string name="general_info_rationale_process_name">Nama proses sistem operasi tempat aplikasi berjalan. Secara default, ini cocok dengan nama paket.</string>
    <string name="general_info_rationale_uid">Pengidentifikasi unik yang diberikan kepada aplikasi ini oleh sistem Android. Ini menentukan akses aplikasi ke sumber daya sistem dan izin file.</string>
    <string name="general_info_rationale_shared_user_id">Aplikasi ini menyatakan bahwa ia berjalan di bawah identitas bersama dengan aplikasi lain yang ditandatangani dengan kunci yang sama. Aplikasi yang berbagi identitas ini dapat mengakses data dan izin satu sama lain seolah-olah mereka adalah satu aplikasi.</string>
    <string name="general_info_rationale_description">Ringkasan opsional yang disediakan oleh pengembang aplikasi dalam manifest.</string>
    <string name="general_info_rationale_version_name">String versi yang dapat dibaca manusia yang ditampilkan kepada pengguna, seperti "2.5.1" atau "Beta 3".</string>
    <string name="general_info_rationale_version_code">Integer internal yang meningkat dengan setiap rilis. Sistem menggunakannya untuk menentukan apakah satu versi lebih baru dari yang lain.</string>
    <string name="general_info_rationale_min_sdk">Tingkat API Android terendah yang didukung aplikasi ini. Perangkat yang menjalankan versi yang lebih lama tidak dapat menginstalnya.</string>
    <string name="general_info_rationale_target_sdk">Tingkat API yang dirancang dan diuji untuk aplikasi ini. Ini memberi tahu sistem perilaku kompatibilitas mana yang harus diterapkan.</string>
    <string name="general_info_rationale_debug_access_enabled">Alat pengembangan dapat memeriksa dan mengontrol aplikasi ini saat berjalan. Ini membantu selama pengujian, tetapi aplikasi yang diterbitkan biasanya mematikannya karena siapa pun yang memiliki akses debugging ke perangkat mendapatkan akses tambahan ke aplikasi.</string>
    <string name="general_info_rationale_debug_access_disabled">Alat pengembangan tidak dapat terhubung ke aplikasi ini menggunakan akses debugging aplikasi Android yang normal.</string>
    <string name="general_info_rationale_backup_allowed">Android dapat menyertakan data aplikasi ini dalam cadangan atau memindahkannya ke perangkat lain. Data yang tepat tergantung pada aturan cadangan aplikasi dan versi Android.</string>
    <string name="general_info_rationale_backup_blocked">Aplikasi ini menonaktifkan cadangan cloud Android. Transfer antar perangkat mungkin masih bervariasi berdasarkan versi Android dan produsen perangkat.</string>
    <string name="general_info_rationale_cleartext_allowed">Pengaturan manifest umum aplikasi memungkinkan koneksi jaringan tanpa enkripsi. Aturan keamanan jaringan kustom dapat menimpa pengaturan ini. Ini tidak membuktikan bahwa aplikasi mengirim data yang tidak terenkripsi.</string>
    <string name="general_info_rationale_cleartext_blocked">Pengaturan manifest umum aplikasi menonaktifkan koneksi jaringan tanpa enkripsi. Aturan keamanan jaringan kustom dan beberapa pustaka jaringan dapat berperilaku berbeda.</string>
    <string name="general_info_rationale_app_type">Apakah aplikasi ini adalah aplikasi sistem yang diinstal sebelumnya atau aplikasi yang diinstal pengguna. Aplikasi sistem memiliki hak istimewa yang lebih tinggi dan tidak dapat dihapus sepenuhnya.</string>
    <string name="general_info_rationale_install_source_google_play">Aplikasi ini diunduh dan diinstal melalui Google Play, yang menyaring aplikasi sebelum menerbitkannya.</string>
    <string name="general_info_rationale_install_source_samsung_galaxy_store">Aplikasi ini diunduh dan diinstal melalui Galaxy Store Samsung, toko aplikasi milik produsen.</string>
    <string name="general_info_rationale_install_source_amazon_appstore">Aplikasi ini diunduh dan diinstal melalui Amazon Appstore.</string>
    <string name="general_info_rationale_install_source_huawei_app_gallery">Aplikasi ini diunduh dan diinstal melalui AppGallery milik Huawei, toko aplikasi milik produsen.</string>
    <string name="general_info_rationale_install_source_xiaomi_get_apps">Aplikasi ini diunduh dan diinstal melalui toko GetApps milik Xiaomi, toko aplikasi milik produsen.</string>
    <string name="general_info_rationale_install_source_fdroid">Aplikasi ini diunduh dan diinstal melalui F-Droid, sebuah toko yang hanya mendistribusikan aplikasi yang dibangun dari kode sumber terbuka publik.</string>
    <string name="general_info_rationale_install_source_aurora_store">Aplikasi ini diunduh dan diinstal melalui Aurora Store, aplikasi alternatif untuk menjelajahi dan menginstal aplikasi Google Play.</string>
    <string name="general_info_rationale_install_source_sideloaded">Aplikasi ini diinstal secara manual dari file APK yang diunduh daripada melalui toko aplikasi, jadi aplikasi ini tidak melalui proses tinjauan toko.</string>
    <string name="general_info_rationale_install_source_local_install">Aplikasi ini diinstal langsung dari komputer yang terhubung, biasanya menggunakan alat pengembang seperti ADB, daripada melalui toko aplikasi.</string>
    <string name="general_info_rationale_install_source_system">Aplikasi ini sudah terpasang sebelumnya di perangkat sebagai bagian dari sistem operasi atau perangkat lunak produsen.</string>
    <string name="general_info_rationale_install_source_unknown">Android tidak dapat melaporkan dari mana aplikasi ini diinstal. Ini bisa terjadi setelah memulihkan cadangan perangkat atau dengan beberapa penginstal khusus produsen.</string>
    <string name="general_info_rationale_installer_package">Nama paket aplikasi yang melakukan instalasi, seperti "com.android.vending" untuk Google Play.</string>
    <string name="general_info_rationale_install_initiator">Aplikasi yang memulai instalasi, seperti browser atau pengelola file untuk aplikasi yang diinstal secara sideload, atau toko aplikasi untuk instalasi dari toko. Ini bisa berbeda dari paket penginstal di atas.</string>
    <string name="general_info_rationale_install_originator">Paket yang menyediakan file APK, ketika Android melaporkannya terpisah dari aplikasi yang memulai instalasi. Sebagian besar instalasi meninggalkan ini kosong.</string>
    <string name="general_info_rationale_first_installed">Tanggal dan waktu aplikasi ini pertama kali diinstal di perangkat.</string>
    <string name="general_info_rationale_last_updated">Tanggal dan waktu pembaruan terbaru untuk aplikasi ini.</string>
    <string name="general_info_rationale_last_used">Tanggal dan waktu perkiraan aplikasi ini terakhir dibuka oleh pengguna.</string>
    <string name="general_info_rationale_apk_directory">Jalur sistem file tempat file APK disimpan di perangkat.</string>
    <string name="general_info_rationale_data_directory">Jalur sistem file tempat aplikasi menyimpan data pribadi, basis data, dan preferensi bersama.</string>
    <string name="general_info_rationale_install_location">Lokasi penyimpanan yang disukai yang dinyatakan oleh pengembang — penyimpanan internal, penyimpanan eksternal, atau otomatis.</string>
    <string name="general_info_rationale_apk_size">Ukuran gabungan dari file APK yang terinstal di disk, tidak termasuk data aplikasi, cache, dan file yang dihasilkan saat runtime. Sebagian besar aplikasi yang diinstal dari Google Play dibagi menjadi satu APK dasar ditambah APK tambahan untuk bahasa dan kepadatan layar perangkat Anda; total ini mencakup semuanya.</string>
    <string name="general_info_rationale_total_size">Ukuran gabungan dari APK, data aplikasi, dan file yang di-cache. Memerlukan izin akses penggunaan.</string>
    <string name="general_info_rationale_native_library_abis">Jenis prosesor yang termasuk kode native yang dikompilasi untuk aplikasi ini, dibaca dari file APK\'s sendiri daripada apa yang dilaporkan perangkat ini.</string>
    <string name="general_info_native_library_device_support">Perangkat ini mendukung: %1$s.</string>
    <string name="general_info_native_library_incompatible">Tidak ada jenis prosesor tersebut yang cocok dengan apa yang didukung perangkat ini, jadi kode native aplikasi ini kemungkinan tidak akan berjalan di sini.</string>
