    <string name="general_info_rationale_application_name">Viditeľný názov aplikácie pre používateľa, ako je zobrazený na domovskej obrazovke a v zozname aplikácií.</string>
    <string name="general_info_rationale_package_name">Jedinečný identifikátor pre túto aplikáciu na zariadení. Žiadne dve aplikácie nemôžu zdieľať rovnaké meno balíka.</string>
    <string name="general_info_rationale_process_name">Názov procesu operačného systému, v ktorom aplikácia beží. Predvolene sa zhoduje s menom balíka.</string>
    <string name="general_info_rationale_uid">Jedinečný identifikátor priradený tejto aplikácii systémom Android. Určuje prístup aplikácie k systémovým zdrojom a povoleniam súborov.</string>
    <string name="general_info_rationale_shared_user_id">Táto aplikácia deklaruje, že beží pod zdieľanou identitou s inými aplikáciami podpísanými rovnakým kľúčom. Aplikácie zdieľajúce túto identitu môžu pristupovať k údajom a povoleniam navzájom, akoby to bola jedna aplikácia.</string>
    <string name="general_info_rationale_description">Voliteľné zhrnutie poskytnuté vývojárom aplikácie v manifeste.</string>
    <string name="general_info_rationale_version_name">Verzia čitateľná pre ľudí zobrazená používateľom, ako napríklad "2.5.1" alebo "Beta 3".</string>
    <string name="general_info_rationale_version_code">Interná verzia. Celé číslo, ktoré sa zvyšuje s každým vydaním. Systém ho používa na určenie, či je jedna verzia novšia ako iná.</string>
    <string name="general_info_rationale_min_sdk">Najnižšia úroveň Android API, ktorú táto aplikácia podporuje. Zariadenia s staršou verziou ju nemôžu nainštalovať.</string>
    <string name="general_info_rationale_target_sdk">Úroveň API, pre ktorú bola aplikácia navrhnutá a testovaná. Hovorí systému, aké správanie kompatibility má aplikovať.</string>
    <string name="general_info_rationale_debug_access_enabled">Nástroje na vývoj môžu kontrolovať a spravovať túto aplikáciu počas jej behu. To pomáha počas testovania, ale publikované aplikácie to zvyčajne vypínajú, pretože ktokoľvek s prístupom na ladenie k zariadeniu získa dodatočný prístup k aplikácii.</string>
    <string name="general_info_rationale_debug_access_disabled">Nástroje na vývoj sa nemôžu pripojiť k tejto aplikácii pomocou normálneho prístupu na ladenie aplikácií Android.</string>
    <string name="general_info_rationale_backup_allowed">Android môže zahrnúť údaje tejto aplikácie do záloh alebo ich presunúť na iné zariadenie. Presné údaje závisia od pravidiel zálohovania aplikácie a verzie Androidu.</string>
    <string name="general_info_rationale_backup_blocked">Aplikácia zakazuje zálohovanie do cloudu Android. Prenos medzi zariadeniami sa môže stále líšiť podľa verzie Android a výrobcu zariadenia.</string>
    <string name="general_info_rationale_cleartext_allowed">Všeobecné nastavenie manifestu aplikácie umožňuje sieťové pripojenia bez šifrovania. Vlastné pravidlá zabezpečenia siete môžu toto nastavenie prepisovať. To neznamená, že aplikácia posiela nešifrované údaje.</string>
    <string name="general_info_rationale_cleartext_blocked">Všeobecné nastavenie manifestu aplikácie zakazuje sieťové pripojenia bez šifrovania. Vlastné pravidlá zabezpečenia siete a niektoré knižnice pre sieťovanie sa môžu správať inak.</string>
    <string name="general_info_rationale_app_type">Či je aplikácia predinštalovaná systémová aplikácia alebo aplikácia nainštalovaná používateľom. Systémové aplikácie majú zvýšené povolenia a nemôžu byť úplne odinštalované.</string>
    <string name="general_info_rationale_install_source_google_play">Táto aplikácia bola stiahnutá a nainštalovaná prostredníctvom Google Play, ktorý kontroluje aplikácie pred ich publikovaním.</string>
    <string name="general_info_rationale_install_source_samsung_galaxy_store">Táto aplikácia bola stiahnutá a nainštalovaná prostredníctvom Galaxy Store od Samsungu, vlastného obchodu výrobcu.</string>
    <string name="general_info_rationale_install_source_amazon_appstore">Táto aplikácia bola stiahnutá a nainštalovaná prostredníctvom Amazon Appstore.</string>
    <string name="general_info_rationale_install_source_huawei_app_gallery">Táto aplikácia bola stiahnutá a nainštalovaná prostredníctvom AppGallery od Huawei, vlastného obchodu výrobcu.</string>
    <string name="general_info_rationale_install_source_xiaomi_get_apps">Táto aplikácia bola stiahnutá a nainštalovaná prostredníctvom GetApps obchodu od Xiaomi, vlastného obchodu výrobcu.</string>
    <string name="general_info_rationale_install_source_fdroid">Táto aplikácia bola stiahnutá a nainštalovaná prostredníctvom F-Droid, obchodu, ktorý distribuuje iba aplikácie vytvorené z verejného, otvoreného kódu.</string>
    <string name="general_info_rationale_install_source_aurora_store">Táto aplikácia bola stiahnutá a nainštalovaná prostredníctvom Aurora Store, alternatívnej aplikácie na prehliadanie a inštaláciu aplikácií z Google Play.</string>
    <string name="general_info_rationale_install_source_sideloaded">Táto aplikácia bola nainštalovaná manuálne z stiahnutého APK súboru, nie prostredníctvom obchodu s aplikáciami, takže neprešla procesom kontroly obchodu.</string>
    <string name="general_info_rationale_install_source_local_install">Táto aplikácia bola nainštalovaná priamo z pripojeného počítača, zvyčajne pomocou vývojárskeho nástroja ako ADB, nie prostredníctvom obchodu s aplikáciami.</string>
    <string name="general_info_rationale_install_source_system">Táto aplikácia bola predinštalovaná na zariadení ako súčasť operačného systému alebo softvéru výrobcu.</string>
    <string name="general_info_rationale_install_source_unknown">Android nemohol oznámiť, odkiaľ bola táto aplikácia nainštalovaná. To sa môže stať po obnovení zálohy zariadenia alebo s niektorými inštalátormi špecifickými pre výrobcu.</string>
    <string name="general_info_rationale_installer_package">Názov balíka aplikácie, ktorá vykonala inštaláciu, ako napríklad "com.android.vending" pre Google Play.</string>
    <string name="general_info_rationale_install_initiator">Aplikácia, ktorá spustila inštaláciu, ako napríklad prehliadač alebo správca súborov pre aplikáciu nainštalovanú mimo obchodu, alebo obchod s aplikáciami pre inštaláciu z obchodu. To sa môže líšiť od vyššie uvedeného inštalátora balíka.</string>
    <string name="general_info_rationale_install_originator">Balík, ktorý poskytol APK súbor, keď Android hlási, že je oddelený od aplikácie, ktorá spustila inštaláciu. Väčšina inštalácií necháva toto prázdne.</string>
    <string name="general_info_rationale_first_installed">Dátum a čas, kedy bola táto aplikácia prvýkrát nainštalovaná na zariadení.</string>
    <string name="general_info_rationale_last_updated">Dátum a čas poslednej aktualizácie tejto aplikácie.</string>
    <string name="general_info_rationale_last_used">Približný dátum a čas, kedy bola táto aplikácia naposledy otvorená používateľom.</string>
    <string name="general_info_rationale_apk_directory">Cesta v súborovom systéme, kde je súbor APK uložený na zariadení.</string>
    <string name="general_info_rationale_data_directory">Cesta v súborovom systéme, kde aplikácia ukladá svoje súkromné údaje, databázy a zdieľané preferencie.</string>
    <string name="general_info_rationale_install_location">Preferované miesto na ukladanie deklarované vývojárom — interné úložisko, externé úložisko alebo automatické.</string>
    <string name="general_info_rationale_apk_size">Kombinovaná veľkosť nainštalovaných súborov APK na disku, bez údajov aplikácie, cache a súborov generovaných za behu. Väčšina aplikácií nainštalovaných z Google Play je rozdelená na základný APK plus ďalšie APKs pre jazyk a hustotu obrazovky vášho zariadenia; tento celkový objem pokrýva všetky z nich.</string>
    <string name="general_info_rationale_total_size">Kombinovaná veľkosť APK, údajov aplikácie a cache súborov. Vyžaduje povolenie na prístup k používaniu.</string>
    <string name="general_info_rationale_native_library_abis">Typy procesorov, pre ktoré táto aplikácia obsahuje skompilovaný natívny kód, čítané z vlastných súborov APK namiesto toho, čo toto zariadenie hlási.</string>
    <string name="general_info_native_library_device_support">Toto zariadenie podporuje: %1$s.</string>
    <string name="general_info_native_library_incompatible">Žiadny z týchto typov procesorov nezodpovedá tomu, čo toto zariadenie podporuje, takže natívny kód tejto aplikácie pravdepodobne nebude fungovať tu.</string>
