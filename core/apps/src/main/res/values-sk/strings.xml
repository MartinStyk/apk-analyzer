    <string name="components_detail_intent_categories_explanation">Kategórie, ktoré tento filter povoľuje. Každá poskytnutá kategória musí byť uvedená tu.</string>
    <string name="components_detail_intent_data">Odkazy a obsah</string>
    <string name="components_detail_intent_data_explanation">Webové adresy, typy súborov alebo iný obsah, ktorý tento komponent tvrdí, že môže spracovať.</string>
    <string name="components_detail_intent_data_rule">%1$s: %2$s</string>
    <string name="components_detail_intent_allowed_uri_parts">Povolené podrobnosti odkazu</string>
    <string name="components_detail_intent_allowed_uri_parts_explanation">Všetky podrobnosti v tejto skupine musia zodpovedať, aby skupina povolila odkaz. Android vyhodnocuje skupiny v poradí manifestu.</string>
    <string name="components_detail_intent_blocked_uri_parts">Podrobnosti o zablokovanom odkaze</string>
    <string name="components_detail_intent_blocked_uri_parts_explanation">Tieto podrobnosti definujú pravidlo na zablokovanie zhody. Android to vyhodnocuje s ostatnými pravidlami odkazu vo filtri v poradí manifestu.</string>
    <string name="components_detail_intent_auto_verify">Žiadosť o overenie</string>
    <string name="components_detail_intent_auto_verify_requested">Požadované</string>
    <string name="components_detail_intent_auto_verify_explanation">Aplikácia žiada Android, aby overil, že jej podpisová identita má povolenie otvárať tieto webové odkazy.</string>
    <string name="components_detail_intent_activity_priority">Priorita zhody</string>
