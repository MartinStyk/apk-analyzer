    <string name="general_info_rationale_application_name">Viditelný název aplikace pro uživatele, jak je zobrazen na domovské obrazovce a v zásuvce aplikací.</string>
    <string name="general_info_rationale_package_name">Jedinečný identifikátor této aplikace na zařízení. Žádné dvě aplikace nemohou sdílet stejné jméno balíčku.</string>
    <string name="general_info_rationale_process_name">Název procesu operačního systému, ve kterém aplikace běží. Ve výchozím nastavení odpovídá názvu balíčku.</string>
    <string name="general_info_rationale_uid">Jedinečný identifikátor přidělený této aplikaci systémem Android. Určuje přístup aplikace k systémovým prostředkům a oprávněním k souborům.</string>
    <string name="general_info_rationale_shared_user_id">Tato aplikace deklaruje, že běží pod sdílenou identitou s jinými aplikacemi podepsanými stejným klíčem. Aplikace sdílející tuto identitu mohou přistupovat k datům a oprávněním navzájem, jako by to byla jedna aplikace.</string>
    <string name="general_info_rationale_description">Volitelný souhrn poskytnutý vývojářem aplikace v manifestu.</string>
    <string name="general_info_rationale_version_name">Lidsky čitelný řetězec verze zobrazený uživatelům, například "2.5.1" nebo "Beta 3".</string>
    <string name="general_info_rationale_version_code">Interní celé číslo, které se zvyšuje s každým vydáním. Systém ho používá k určení, zda je jedna verze novější než jiná.</string>
    <string name="general_info_rationale_min_sdk">Nejnižší úroveň API Androidu, kterou tato aplikace podporuje. Zařízení běžící na starší verzi ji nemohou nainstalovat.</string>
    <string name="general_info_rationale_target_sdk">Úroveň API, pro kterou byla aplikace navržena a testována. Říká systému, jaké chování kompatibility použít.</string>
    <string name="general_info_rationale_debug_access_enabled">Nástroje pro vývoj mohou inspektovat a ovládat tuto aplikaci, zatímco běží. To pomáhá během testování, ale publikované aplikace to obvykle vypínají, protože kdokoli s přístupem k ladění zařízení získává další přístup k aplikaci.</string>
    <string name="general_info_rationale_debug_access_disabled">Nástroje pro vývoj se nemohou připojit k této aplikaci pomocí běžného přístupu k ladění aplikací Androidu.</string>
    <string name="general_info_rationale_backup_allowed">Android může zahrnout data této aplikace do záloh nebo je přesunout na jiné zařízení. Přesná data závisí na pravidlech zálohování aplikace a verzi Androidu.</string>
    <string name="general_info_rationale_backup_blocked">Aplikace zakazuje zálohování do cloudu Androidu. Přenos mezi zařízeními se může stále lišit podle verze Androidu a výrobce zařízení.</string>
    <string name="general_info_rationale_cleartext_allowed">Obecné nastavení manifestu aplikace umožňuje síťová připojení bez šifrování. Vlastní pravidla zabezpečení sítě mohou toto nastavení přepsat. To neprokazuje, že aplikace odesílá nešifrovaná data.</string>
    <string name="general_info_rationale_cleartext_blocked">Obecné nastavení manifestu aplikace zakazuje síťová připojení bez šifrování. Vlastní pravidla zabezpečení sítě a některé knihovny pro síťovou komunikaci se mohou chovat jinak.</string>
    <string name="general_info_rationale_app_type">Zda je aplikace předinstalovaná systémová aplikace nebo aplikace nainstalovaná uživatelem. Systémové aplikace mají zvýšená oprávnění a nelze je zcela odinstalovat.</string>
    <string name="general_info_rationale_install_source_google_play">Tato aplikace byla stažena a nainstalována prostřednictvím Google Play, který kontroluje aplikace před jejich publikováním.</string>
    <string name="general_info_rationale_install_source_samsung_galaxy_store">Tato aplikace byla stažena a nainstalována prostřednictvím Galaxy Store od Samsungu, vlastního obchodu výrobce.</string>
    <string name="general_info_rationale_install_source_amazon_appstore">Tato aplikace byla stažena a nainstalována prostřednictvím Amazon Appstore.</string>
    <string name="general_info_rationale_install_source_huawei_app_gallery">Tato aplikace byla stažena a nainstalována prostřednictvím AppGallery od Huawei, vlastního obchodu výrobce.</string>
    <string name="general_info_rationale_install_source_xiaomi_get_apps">Tato aplikace byla stažena a nainstalována prostřednictvím obchodu GetApps od Xiaomi, vlastního obchodu výrobce.</string>
    <string name="general_info_rationale_install_source_fdroid">Tato aplikace byla stažena a nainstalována prostřednictvím F-Droid, obchodu, který distribuuje pouze aplikace postavené z veřejného, otevřeného kódu.</string>
    <string name="general_info_rationale_install_source_aurora_store">Tato aplikace byla stažena a nainstalována prostřednictvím Aurora Store, alternativní aplikace pro procházení a instalaci aplikací z Google Play.</string>
    <string name="general_info_rationale_install_source_sideloaded">Tato aplikace byla nainstalována ručně z staženého APK souboru, nikoli prostřednictvím obchodu s aplikacemi, takže neprošla procesem kontroly obchodu.</string>
    <string name="general_info_rationale_install_source_local_install">Tato aplikace byla nainstalována přímo z připojeného počítače, obvykle pomocí vývojářského nástroje, jako je ADB, nikoli prostřednictvím obchodu s aplikacemi.</string>
    <string name="general_info_rationale_install_source_system">Tato aplikace byla předinstalována na zařízení jako součást operačního systému nebo softwaru výrobce.</string>
    <string name="general_info_rationale_install_source_unknown">Android nemohl oznámit, odkud byla tato aplikace nainstalována. To se může stát po obnovení zálohy zařízení nebo s některými specifickými instalátory výrobce.</string>
    <string name="general_info_rationale_installer_package">Název balíčku aplikace, která provedla instalaci, například "com.android.vending" pro Google Play.</string>
    <string name="general_info_rationale_install_initiator">Aplikace, která zahájila instalaci, například prohlížeč nebo správce souborů pro aplikaci nainstalovanou mimo obchod, nebo obchod s aplikacemi pro instalaci z obchodu. To se může lišit od výše uvedeného instalačního balíčku.</string>
    <string name="general_info_rationale_install_originator">Balíček, který poskytl APK soubor, když Android hlásí odděleně od aplikace, která zahájila instalaci. Většina instalací toto pole nechává prázdné.</string>
    <string name="general_info_rationale_first_installed">Datum a čas, kdy byla tato aplikace poprvé nainstalována na zařízení.</string>
    <string name="general_info_rationale_last_updated">Datum a čas poslední aktualizace této aplikace.</string>
    <string name="general_info_rationale_last_used">Přibližné datum a čas, kdy byla tato aplikace naposledy otevřena uživatelem.</string>
    <string name="general_info_rationale_apk_directory">Cesta k souborovému systému, kde je soubor APK uložen na zařízení.</string>
    <string name="general_info_rationale_data_directory">Cesta k souborovému systému, kde aplikace ukládá svá soukromá data, databáze a sdílené preference.</string>
    <string name="general_info_rationale_install_location">Preferované umístění pro ukládání deklarované vývojářem — interní úložiště, externí úložiště nebo automatické.</string>
    <string name="general_info_rationale_apk_size">Kombinovaná velikost nainstalovaných souborů APK na disku, s výjimkou dat aplikace, mezipamětí a souborů generovaných za běhu. Většina aplikací nainstalovaných z Google Play je rozdělena na základní APK plus další APKs pro jazyk a hustotu obrazovky vašeho zařízení; tento celkový objem pokrývá všechny z nich.</string>
    <string name="general_info_rationale_total_size">Kombinovaná velikost APK, dat aplikace a mezipaměťových souborů. Vyžaduje oprávnění pro přístup k používání.</string>
    <string name="general_info_rationale_native_library_abis">Typy procesorů, pro které tato aplikace obsahuje zkompilovaný nativní kód, čtené z vlastních souborů APK namísto toho, co toto zařízení hlásí.</string>
    <string name="general_info_native_library_device_support">Toto zařízení podporuje: %1$s.</string>
    <string name="general_info_native_library_incompatible">Žádný z těchto typů procesorů neodpovídá tomu, co toto zařízení podporuje, takže nativní kód této aplikace pravděpodobně nebude fungovat zde.</string>
