    <string name="components_detail_intent_blocked_uri_parts">Podrobnosti o zablokovaném odkazu</string>
    <string name="components_detail_intent_blocked_uri_parts_explanation">Tyto podrobnosti definují pravidlo pro zablokování shody. Android je vyhodnocuje spolu s ostatními pravidly odkazu ve filtru v pořadí manifestu.</string>
    <string name="components_detail_intent_auto_verify">Žádost o ověření</string>
    <string name="components_detail_intent_auto_verify_requested">Požadováno</string>
    <string name="components_detail_intent_auto_verify_explanation">Aplikace žádá Android, aby ověřil, že její identita podepisování má povolení k otevření těchto odkazů na webové stránky.</string>
    <string name="components_detail_intent_activity_priority">Priorita shody</string>
    <string name="components_detail_intent_activity_priority_explanation">Vyšší číslo může učinit tuto aktivitu preferovanou před jinými shodnými aktivitami, v souladu s pravidly směrování Androidu.</string>
    <string name="components_detail_intent_receiver_priority">Priorita vysílání</string>
    <string name="components_detail_intent_receiver_priority_explanation">Pro seřazená vysílání může vyšší číslo způsobit, že tento přijímač poběží dříve, v souladu s limity Androidu.</string>
    <string name="components_detail_intent_declared_priority">Deklarovaná priorita</string>
