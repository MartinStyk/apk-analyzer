    <string name="certificates_scheme">Schéma</string>
    <string name="certificates_scheme_v1">v1</string>
    <string name="certificates_scheme_v2">v2</string>
    <string name="certificates_scheme_v3">v3</string>
    <string name="certificates_scheme_v3_1">v3.1</string>
    <string name="certificates_scheme_explanation">Schéma je formát podpisu, který Android použil k ověření tohoto APK. Novější schémata (v2 a novější) také chrání celý soubor, nejen jednotlivé položky, takže moderní aplikace podepsaná pouze v1 stojí za druhý pohled. Algoritmus níže popisuje, jak byl samotný podpisový certifikát podepsán, nikoli APK podpisové schéma.</string>
    <string name="certificates_algorithm">Algoritmus</string>
    <string name="certificates_algorithm_strong">Silný</string>
    <string name="certificates_algorithm_weak">Slabý</string>
    <string name="certificates_algorithm_unknown">Neznámá síla</string>
    <string name="certificates_algorithm_strong_explanation">%1$s používá SHA-256 nebo silnější hash. Žádný praktický útok na kolize není znám, i když celková bezpečnost také závisí na typu a velikosti podpisového klíče.</string>
    <string name="certificates_algorithm_sha1_explanation">%1$s používá SHA-1. SHA-1 již není odolný vůči kolizím, takže útočník může vytvořit různá data se stejným hashem. Nové podpisové certifikáty by měly používat SHA-256 nebo silnější.</string>
    <string name="certificates_algorithm_md5_explanation">%1$s používá MD5. MD5 není odolný vůči kolizím a je nebezpečný pro podpisové certifikáty. Nové podpisové certifikáty by měly používat SHA-256 nebo silnější.</string>
    <string name="certificates_algorithm_md2_explanation">%1$s používá MD2. MD2 je zastaralý a zranitelný vůči praktickým útokům, takže je nebezpečný pro podpisové certifikáty. Nové podpisové certifikáty by měly používat SHA-256 nebo silnější.</string>
    <string name="certificates_algorithm_unknown_explanation">Sílu %1$s nelze posoudit podle názvu jeho algoritmu. Typ a velikost klíče mohou také ovlivnit jeho bezpečnost.</string>
    <string name="certificates_serial">Sériové číslo</string>
    <string name="certificates_serial_explanation">Tento číslo přiděluje vydavatel certifikátu k identifikaci certifikátu. Použijte ho spolu s názvem vydavatele; není to otisk certifikátu.</string>
