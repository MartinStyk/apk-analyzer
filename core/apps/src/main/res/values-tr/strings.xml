    <string name="components_detail_intent_receiver_priority">Yayın önceliği</string>
    <string name="components_detail_intent_receiver_priority_explanation">Sıralı yayınlar için, daha yüksek bir sayı bu alıcının daha erken çalışmasını sağlayabilir, Android\'in sınırlarına tabi olarak.</string>
    <string name="components_detail_intent_declared_priority">Beyan edilen öncelik</string>
