    <string name="app_history_settings_recording_section">Zaznamenávání</string>
    <string name="app_history_settings_recording_toggle">Zaznamenávat změny aplikací</string>
    <string name="app_history_settings_recording_description">Při instalaci nebo aktualizaci aplikace uloží její podrobnosti, aby karta Změny a historie každé aplikace mohly ukázat, co se změnilo.</string>
    <string name="app_history_settings_recording_off_title">Zaznamenávání je vypnuté</string>
    <string name="app_history_settings_recording_off_body">Nové instalace a aktualizace se nezaznamenávají. Karta Změny a historie každé aplikace zůstanou takové, jaké jsou, dokud zaznamenávání znovu nezapnete.</string>
    <string name="app_history_settings_turn_off_title">Vypnout zaznamenávání?</string>
    <string name="app_history_settings_turn_off_message">Instalace a aktualizace během vypnutého zaznamenávání se nezobrazí na kartě Změny ani v historii aplikace. Když ho znovu zapnete, více aktualizací jedné aplikace se zobrazí jako jedna změna a aplikace odebrané mezitím se nezaznamenají vůbec. Všechno, co už je zaznamenané, zůstane.</string>
    <string name="app_history_settings_turn_off_confirm">Vypnout</string>
    <string name="app_history_settings_turn_off_dismiss">Ponechat zapnuté</string>
    <string name="app_history_settings_privacy_title">Zůstává v tomto telefonu</string>
    <string name="app_history_settings_privacy_body">Apk Analyzer ukládá historii aplikací jen v tomto telefonu a nikam ji neposílá. Pokud máte v nastavení telefonu zapnuté zálohování, Android ji zahrne do zálohy ve vašem účtu Google spolu s ostatními daty aplikací.</string>
