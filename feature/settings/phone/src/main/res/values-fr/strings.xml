    <string name="app_history_settings_export_description">Enregistre une copie sous forme de fichier sur ce téléphone ou dans un espace de stockage en ligne comme Google Drive.</string>
    <string name="app_history_settings_import">Importer l\'historique</string>
    <string name="app_history_settings_import_description">Ajoute l\'historique d\'un fichier exporté. Rien de ce qui a déjà été observé n\'est remplacé.</string>
