    <string name="app_history_settings_recording_section">Suivi</string>
    <string name="app_history_settings_recording_toggle">Suivre les changements des applications</string>
    <string name="app_history_settings_recording_description">Enregistre les détails de chaque application quand vous l\'installez ou la mettez à jour, pour que l\'onglet Changements et l\'historique de chaque application puissent montrer ce qui a changé.</string>
    <string name="app_history_settings_recording_off_title">Le suivi est désactivé</string>
    <string name="app_history_settings_recording_off_body">Les nouvelles installations et mises à jour ne sont pas suivies. L\'onglet Changements et l\'historique de chaque application restent tels quels jusqu\'à ce que vous réactiviez le suivi.</string>
    <string name="app_history_settings_turn_off_title">Désactiver le suivi ?</string>
    <string name="app_history_settings_turn_off_message">Les installations et mises à jour effectuées pendant que le suivi est désactivé n\'apparaissent ni dans l\'onglet Changements ni dans l\'historique d\'une application. Quand vous le réactiverez, une application mise à jour plusieurs fois apparaîtra comme un seul changement, et les applications désinstallées entre-temps ne seront jamais observées. Tout ce qui a déjà été observé est conservé.</string>
    <string name="app_history_settings_turn_off_confirm">Désactiver</string>
    <string name="app_history_settings_turn_off_dismiss">Laisser activé</string>
    <string name="app_history_settings_privacy_title">Reste sur ce téléphone</string>
    <string name="app_history_settings_privacy_body">Apk Analyzer conserve l\'historique des applications uniquement sur ce téléphone et ne l\'envoie nulle part. Si la sauvegarde est activée dans les paramètres de votre téléphone, Android l\'inclut dans la sauvegarde de votre compte Google, comme les autres données des applications.</string>
