    <string name="app_history_settings_transfer_section">내보내기 및 가져오기</string>
    <string name="app_history_settings_export">기록 내보내기</string>
    <string name="app_history_settings_export_description">이 휴대전화나 Google 드라이브 같은 클라우드 드라이브에 사본을 파일로 저장합니다.</string>
    <string name="app_history_settings_import">기록 가져오기</string>
    <string name="app_history_settings_import_description">내보낸 파일에서 기록을 추가합니다. 이미 기록된 내용은 대체되지 않습니다.</string>
