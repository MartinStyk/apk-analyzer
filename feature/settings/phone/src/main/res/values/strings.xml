    <string name="app_history_settings_recording_section">Recording</string>
    <string name="app_history_settings_recording_toggle">Record app changes</string>
    <string name="app_history_settings_recording_description">Saves each app\'s details when you install or update it, so the Changes tab and each app\'s History can show what\'s different.</string>
    <string name="app_history_settings_recording_off_title">Recording is off</string>
    <string name="app_history_settings_recording_off_body">New installs and updates aren\'t recorded. The Changes tab and each app\'s History stay as they are until you turn recording back on.</string>
    <string name="app_history_settings_turn_off_title">Turn off recording?</string>
    <string name="app_history_settings_turn_off_message">Installs and updates while recording is off don\'t show up in the Changes tab or in an app\'s History. When you turn it back on, an app updated several times shows as one change, and apps removed in the meantime are never recorded. Everything recorded so far stays.</string>
    <string name="app_history_settings_turn_off_confirm">Turn off</string>
    <string name="app_history_settings_turn_off_dismiss">Keep recording</string>
    <string name="app_history_settings_privacy_title">Stays on this phone</string>
    <string name="app_history_settings_privacy_body">Apk Analyzer saves app history only on this phone and doesn\'t send it anywhere. If backup is on in your phone\'s settings, Android includes it in your Google account backup, like other app data.</string>
