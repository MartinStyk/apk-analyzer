    <string name="app_history_settings_recording_section">Registro</string>
    <string name="app_history_settings_recording_toggle">Registrar alterações dos apps</string>
    <string name="app_history_settings_recording_description">Salva os detalhes de cada app quando você o instala ou atualiza, para que a guia Alterações e o histórico de cada app possam mostrar o que mudou.</string>
    <string name="app_history_settings_recording_off_title">O registro está desativado</string>
    <string name="app_history_settings_recording_off_body">Novas instalações e atualizações não são registradas. A guia Alterações e o histórico de cada app continuam como estão até você ativar o registro novamente.</string>
    <string name="app_history_settings_turn_off_title">Desativar o registro?</string>
    <string name="app_history_settings_turn_off_message">Instalações e atualizações feitas enquanto o registro está desativado não aparecem na guia Alterações nem no histórico de um app. Quando você ativar o registro novamente, um app atualizado várias vezes aparecerá como uma única alteração, e os apps desinstalados nesse meio-tempo nunca serão registrados. Tudo o que já foi registrado continua salvo.</string>
    <string name="app_history_settings_turn_off_confirm">Desativar</string>
    <string name="app_history_settings_turn_off_dismiss">Manter ativado</string>
    <string name="app_history_settings_privacy_title">Fica neste telefone</string>
    <string name="app_history_settings_privacy_body">O Apk Analyzer salva o histórico de apps apenas neste telefone e não o envia para lugar nenhum. Se o backup estiver ativado nas configurações do telefone, o Android o inclui no backup da sua Conta do Google, como outros dados de apps.</string>
