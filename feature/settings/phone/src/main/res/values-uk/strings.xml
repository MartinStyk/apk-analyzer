    </plurals>
    <string name="app_history_settings_storage_empty">Поки нічого не зафіксовано</string>
    <string name="app_history_settings_storage_unavailable">Не вдалося визначити, скільки місця займає історія</string>
    <string name="app_history_settings_transfer_section">Експорт та імпорт</string>
    <string name="app_history_settings_export">Експортувати історію</string>
    <string name="app_history_settings_export_description">Зберігає копію у вигляді файлу на цьому телефоні або в хмарному сховищі, наприклад на Google Диску.</string>
    <string name="app_history_settings_import">Імпортувати історію</string>
    <string name="app_history_settings_import_description">Додає історію з експортованого файлу. Те, що вже зафіксовано, не замінюється.</string>
    <string name="app_history_settings_exported">Історію експортовано</string>
