    <string name="app_history_settings_recording_section">Pencatatan</string>
    <string name="app_history_settings_recording_toggle">Catat perubahan aplikasi</string>
    <string name="app_history_settings_recording_description">Menyimpan detail setiap aplikasi saat Anda menginstal atau memperbaruinya, sehingga tab Perubahan dan Riwayat setiap aplikasi dapat menunjukkan apa yang berbeda.</string>
    <string name="app_history_settings_recording_off_title">Pencatatan nonaktif</string>
    <string name="app_history_settings_recording_off_body">Instalasi dan pembaruan baru tidak dicatat. Tab Perubahan dan Riwayat setiap aplikasi tetap seperti sekarang sampai Anda mengaktifkan pencatatan lagi.</string>
    <string name="app_history_settings_turn_off_title">Nonaktifkan pencatatan?</string>
    <string name="app_history_settings_turn_off_message">Instalasi dan pembaruan selama pencatatan nonaktif tidak muncul di tab Perubahan maupun di Riwayat aplikasi. Saat Anda mengaktifkannya lagi, aplikasi yang diperbarui beberapa kali muncul sebagai satu perubahan, dan aplikasi yang dihapus dalam waktu itu tidak akan pernah tercatat. Semua yang sudah tercatat tetap tersimpan.</string>
    <string name="app_history_settings_turn_off_confirm">Nonaktifkan</string>
    <string name="app_history_settings_turn_off_dismiss">Tetap mencatat</string>
    <string name="app_history_settings_privacy_title">Tetap di ponsel ini</string>
    <string name="app_history_settings_privacy_body">Apk Analyzer menyimpan riwayat aplikasi hanya di ponsel ini dan tidak mengirimkannya ke mana pun. Jika pencadangan diaktifkan di pengaturan ponsel Anda, Android menyertakannya dalam cadangan Akun Google Anda, seperti data aplikasi lainnya.</string>
