    <string name="app_history_settings_export">इतिहास एक्सपोर्ट करें</string>
    <string name="app_history_settings_export_description">इसकी कॉपी को फ़ाइल के रूप में इस फ़ोन पर या Google Drive जैसी क्लाउड ड्राइव में सेव करता है।</string>
    <string name="app_history_settings_import">इतिहास इंपोर्ट करें</string>
    <string name="app_history_settings_import_description">एक्सपोर्ट की गई फ़ाइल से इतिहास जोड़ता है। पहले से दर्ज कोई भी जानकारी बदली नहीं जाती।</string>
