    <string name="app_history_settings_recording_toggle">ऐप में हुए बदलाव दर्ज करें</string>
    <string name="app_history_settings_recording_description">जब आप कोई ऐप इंस्टॉल या अपडेट करते हैं, तो यह उसकी जानकारी सेव करता है, ताकि बदलाव टैब और हर ऐप का इतिहास दिखा सके कि क्या अलग है।</string>
    <string name="app_history_settings_recording_off_title">दर्ज करना बंद है</string>
    <string name="app_history_settings_recording_off_body">नए इंस्टॉल और अपडेट दर्ज नहीं होते। जब तक आप दर्ज करना फिर से चालू नहीं करते, बदलाव टैब और हर ऐप का इतिहास जैसे हैं वैसे ही रहते हैं।</string>
    <string name="app_history_settings_turn_off_title">दर्ज करना बंद करें?</string>
    <string name="app_history_settings_turn_off_message">दर्ज करना बंद रहने के दौरान हुए इंस्टॉल और अपडेट, बदलाव टैब या किसी ऐप के इतिहास में नहीं दिखते। जब आप इसे फिर से चालू करते हैं, तो कई बार अपडेट हुआ ऐप एक ही बदलाव के रूप में दिखता है, और इस बीच हटाए गए ऐप कभी दर्ज नहीं होते। अब तक दर्ज की गई सारी जानकारी बनी रहती है।</string>
    <string name="app_history_settings_turn_off_confirm">बंद करें</string>
    <string name="app_history_settings_turn_off_dismiss">दर्ज करना जारी रखें</string>
    <string name="app_history_settings_privacy_title">इसी फ़ोन पर रहता है</string>
    <string name="app_history_settings_privacy_body">Apk Analyzer ऐप इतिहास सिर्फ़ इसी फ़ोन पर सेव करता है और इसे कहीं नहीं भेजता। अगर आपके फ़ोन की सेटिंग में बैकअप चालू है, तो Android इसे दूसरे ऐप डेटा की तरह आपके Google खाते के बैकअप में शामिल करता है।</string>
    <string name="app_history_settings_storage_section">स्टोरेज</string>
