    <string name="app_history_settings_transfer_section">Экспорт и импорт</string>
    <string name="app_history_settings_export">Экспорт истории</string>
    <string name="app_history_settings_export_description">Сохраняет копию в виде файла на этом телефоне или в облачном хранилище, например на Google Диске.</string>
    <string name="app_history_settings_import">Импорт истории</string>
    <string name="app_history_settings_import_description">Добавляет историю из экспортированного файла. Уже зафиксированные данные не заменяются.</string>
