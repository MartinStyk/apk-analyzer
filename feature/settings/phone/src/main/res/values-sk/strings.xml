    <string name="app_history_settings_recording_section">Zaznamenávanie</string>
    <string name="app_history_settings_recording_toggle">Zaznamenávať zmeny aplikácií</string>
    <string name="app_history_settings_recording_description">Pri inštalácii alebo aktualizácii aplikácie uloží jej podrobnosti, aby karta Zmeny a história každej aplikácie mohli ukázať, čo sa zmenilo.</string>
    <string name="app_history_settings_recording_off_title">Zaznamenávanie je vypnuté</string>
    <string name="app_history_settings_recording_off_body">Nové inštalácie a aktualizácie sa nezaznamenávajú. Karta Zmeny a história každej aplikácie zostanú také, aké sú, kým zaznamenávanie znova nezapnete.</string>
    <string name="app_history_settings_turn_off_title">Vypnúť zaznamenávanie?</string>
    <string name="app_history_settings_turn_off_message">Inštalácie a aktualizácie počas vypnutého zaznamenávania sa nezobrazia na karte Zmeny ani v histórii aplikácie. Keď ho znova zapnete, viacero aktualizácií jednej aplikácie sa zobrazí ako jedna zmena a aplikácie odstránené medzitým sa nezaznamenajú vôbec. Všetko, čo už je zaznamenané, zostane.</string>
    <string name="app_history_settings_turn_off_confirm">Vypnúť</string>
    <string name="app_history_settings_turn_off_dismiss">Ponechať zapnuté</string>
    <string name="app_history_settings_privacy_title">Zostáva v tomto telefóne</string>
    <string name="app_history_settings_privacy_body">Apk Analyzer ukladá históriu aplikácií iba v tomto telefóne a nikam ju neposiela. Ak máte v nastaveniach telefónu zapnuté zálohovanie, Android ju zahrnie do zálohy vo vašom účte Google spolu s ostatnými údajmi aplikácie.</string>
