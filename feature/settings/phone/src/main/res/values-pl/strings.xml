    <string name="app_history_settings_export_description">Zapisuje kopię jako plik na tym telefonie lub na dysku w chmurze, np. na Dysku Google.</string>
    <string name="app_history_settings_import">Importuj historię</string>
    <string name="app_history_settings_import_description">Dodaje historię z wyeksportowanego pliku. Nic, co zostało już zapisane, nie zostanie zastąpione.</string>
