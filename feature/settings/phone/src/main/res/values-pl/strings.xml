    <string name="app_history_settings_recording_section">Zapisywanie</string>
    <string name="app_history_settings_recording_toggle">Zapisuj zmiany aplikacji</string>
    <string name="app_history_settings_recording_description">Zapisuje szczegóły aplikacji przy każdej instalacji lub aktualizacji, aby karta „Zmiany” i historia każdej aplikacji mogły pokazać, co się zmieniło.</string>
    <string name="app_history_settings_recording_off_title">Zapisywanie jest wyłączone</string>
    <string name="app_history_settings_recording_off_body">Nowe instalacje i aktualizacje nie są zapisywane. Karta „Zmiany” i historia każdej aplikacji pozostaną w obecnym stanie, dopóki ponownie nie włączysz zapisywania.</string>
    <string name="app_history_settings_turn_off_title">Wyłączyć zapisywanie?</string>
    <string name="app_history_settings_turn_off_message">Gdy zapisywanie jest wyłączone, instalacje i aktualizacje nie pojawiają się na karcie „Zmiany” ani w historii aplikacji. Po ponownym włączeniu aplikacja zaktualizowana kilka razy pojawi się jako jedna zmiana, a aplikacje usunięte w międzyczasie w ogóle nie zostaną zapisane. Wszystko, co zostało już zapisane, pozostanie.</string>
    <string name="app_history_settings_turn_off_confirm">Wyłącz</string>
    <string name="app_history_settings_turn_off_dismiss">Nie wyłączaj</string>
    <string name="app_history_settings_privacy_title">Zostaje na tym telefonie</string>
    <string name="app_history_settings_privacy_body">Apk Analyzer zapisuje historię aplikacji tylko na tym telefonie i nigdzie jej nie wysyła. Jeśli w ustawieniach telefonu jest włączona kopia zapasowa, Android dołącza ją do kopii zapasowej na Twoim koncie Google, tak jak inne dane aplikacji.</string>
