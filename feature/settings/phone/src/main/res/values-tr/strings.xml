    <string name="app_history_settings_recording_toggle">Uygulama değişikliklerini kaydet</string>
    <string name="app_history_settings_recording_description">Yüklediğiniz veya güncellediğiniz her uygulamanın ayrıntılarını kaydeder; böylece Değişiklikler sekmesi ve her uygulamanın geçmişi neyin değiştiğini gösterebilir.</string>
    <string name="app_history_settings_recording_off_title">Kayıt kapalı</string>
    <string name="app_history_settings_recording_off_body">Yeni yüklemeler ve güncellemeler kaydedilmiyor. Kaydı tekrar açana kadar Değişiklikler sekmesi ve her uygulamanın geçmişi olduğu gibi kalır.</string>
    <string name="app_history_settings_turn_off_title">Kayıt kapatılsın mı?</string>
    <string name="app_history_settings_turn_off_message">Kayıt kapalıyken yapılan yüklemeler ve güncellemeler Değişiklikler sekmesinde veya uygulamanın geçmişinde görünmez. Kaydı tekrar açtığınızda, birkaç kez güncellenen bir uygulama tek bir değişiklik olarak görünür ve bu sırada kaldırılan uygulamalar hiç kaydedilmez. Şimdiye kadar kaydedilen her şey korunur.</string>
    <string name="app_history_settings_turn_off_confirm">Kapat</string>
    <string name="app_history_settings_turn_off_dismiss">Açık kalsın</string>
    <string name="app_history_settings_privacy_title">Bu telefonda kalır</string>
