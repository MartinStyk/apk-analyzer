    <string name="app_history_settings_export">Verlauf exportieren</string>
    <string name="app_history_settings_export_description">Speichert eine Kopie als Datei auf diesem Smartphone oder in einem Cloud-Speicher wie Google Drive.</string>
    <string name="app_history_settings_import">Verlauf importieren</string>
    <string name="app_history_settings_import_description">Fügt den Verlauf aus einer exportierten Datei hinzu. Bereits Erfasstes wird nicht ersetzt.</string>
