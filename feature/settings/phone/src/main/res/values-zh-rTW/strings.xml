    <string name="app_history_settings_transfer_section">匯出和匯入</string>
    <string name="app_history_settings_export">匯出歷史記錄</string>
    <string name="app_history_settings_export_description">將副本儲存為檔案，存放在這支手機或 Google 雲端硬碟等雲端儲存空間中。</string>
    <string name="app_history_settings_import">匯入歷史記錄</string>
    <string name="app_history_settings_import_description">從匯出的檔案新增歷史記錄。已記錄的內容不會遭到取代。</string>
    <string name="app_history_settings_exported">已匯出歷史記錄</string>
