    <string name="app_history_settings_recording_section">記錄</string>
    <string name="app_history_settings_recording_toggle">記錄應用程式變更</string>
    <string name="app_history_settings_recording_description">在您安裝或更新應用程式時儲存其詳細資料，讓「變更」分頁和各應用程式的歷史記錄能顯示有哪些不同。</string>
    <string name="app_history_settings_recording_off_title">記錄功能已關閉</string>
    <string name="app_history_settings_recording_off_body">不會記錄新的安裝和更新。在您重新開啟記錄功能前，「變更」分頁和各應用程式的歷史記錄都會維持現狀。</string>
    <string name="app_history_settings_turn_off_title">要關閉記錄功能嗎？</string>
    <string name="app_history_settings_turn_off_message">記錄功能關閉期間的安裝和更新，不會顯示在「變更」分頁或應用程式的歷史記錄中。重新開啟後，更新多次的應用程式只會顯示為一項變更，期間解除安裝的應用程式也完全不會記錄。目前為止記錄的所有內容都會保留。</string>
    <string name="app_history_settings_turn_off_confirm">關閉</string>
    <string name="app_history_settings_turn_off_dismiss">保持開啟</string>
    <string name="app_history_settings_privacy_title">只儲存在這支手機上</string>
    <string name="app_history_settings_privacy_body">Apk Analyzer 只會將應用程式歷史記錄儲存在這支手機上，不會傳送到任何地方。如果您在手機設定中開啟了備份功能，Android 會將這些記錄納入您的 Google 帳戶備份，就像其他應用程式資料一樣。</string>
    <string name="app_history_settings_storage_section">儲存空間</string>
    <string name="app_history_settings_storage_used">已使用的空間</string>
