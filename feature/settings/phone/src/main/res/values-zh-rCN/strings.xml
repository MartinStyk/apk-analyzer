    <string name="app_history_settings_export">导出历史记录</string>
    <string name="app_history_settings_export_description">将副本保存为文件，存放在此手机上或 Google 云端硬盘等云存储中。</string>
    <string name="app_history_settings_import">导入历史记录</string>
    <string name="app_history_settings_import_description">从导出的文件中添加历史记录。不会替换任何已记录的内容。</string>
