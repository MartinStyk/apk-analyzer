    <string name="app_history_settings_recording_section">记录</string>
    <string name="app_history_settings_recording_toggle">记录应用变化</string>
    <string name="app_history_settings_recording_description">在你安装或更新应用时保存其详细信息，以便“变化”标签页和各应用的历史记录显示具体有何不同。</string>
    <string name="app_history_settings_recording_off_title">记录功能已关闭</string>
    <string name="app_history_settings_recording_off_body">不会记录新的安装和更新。在你重新开启记录功能之前，“变化”标签页和各应用的历史记录将保持现状。</string>
    <string name="app_history_settings_turn_off_title">要关闭记录功能吗？</string>
    <string name="app_history_settings_turn_off_message">记录功能关闭期间的安装和更新不会显示在“变化”标签页或应用的历史记录中。重新开启后，多次更新的应用只会显示为一项变化，期间卸载的应用则完全不会被记录。已记录的所有内容都会保留。</string>
    <string name="app_history_settings_turn_off_confirm">关闭</string>
    <string name="app_history_settings_turn_off_dismiss">保持开启</string>
    <string name="app_history_settings_privacy_title">仅保存在此手机上</string>
    <string name="app_history_settings_privacy_body">Apk Analyzer 仅将应用历史记录保存在此手机上，不会发送到任何地方。如果你在手机设置中开启了备份，Android 会像对待其他应用数据一样，将其包含在你的 Google 账号备份中。</string>
