    <string name="sort_permission_usage_title">Povoliť prístup k používaniu</string>
    <string name="sort_permission_usage_description">Triedenie podľa posledného použitia potrebuje vedieť, kedy ste naposledy otvorili každú aplikáciu. Povoľte prístup k používaniu v Nastaveniach, aby ste aktivovali túto možnosť triedenia.</string>
    <string name="sort_permission_storage_title">Povoliť prístup k používaniu</string>
    <string name="sort_permission_storage_description">Triedenie podľa celkovej veľkosti meria celkovú stopu každej aplikácie — inštalátor, uložené dáta a vyrovnávaciu pamäť spolu. Povoľte prístup k používaniu v Nastaveniach, aby ste aktivovali túto možnosť triedenia.</string>
