    <string name="sort_permission_usage_title">Povoliť prístup k používaniu</string>
    <string name="sort_permission_usage_description">Zoradenie podľa posledného použitia potrebuje vedieť, kedy ste naposledy otvorili každú aplikáciu. Povoľte prístup k údajom o používaní v Nastaveniach, aby ste aktivovali túto možnosť triedenia.</string>
