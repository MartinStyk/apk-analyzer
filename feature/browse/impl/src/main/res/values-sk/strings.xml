    <string name="browse_protection_level_dangerous_explanation">Vyžaduje si výslovné schválenie používateľom predtým, ako ho aplikácia môže použiť.</string>
    <string name="browse_protection_level_signature_explanation">Povolenie môžu získať iba aplikácie podpísané rovnakým kľúčom ako aplikácia, ktorá ho deklarovala.</string>
    <string name="browse_protection_level_internal_explanation">Vyhradené pre systém a udeľované internými pravidlami, nie používateľom.</string>
    <string name="browse_protection_level_normal_explanation">Zvyčajne sa automaticky udeľuje pri inštalácii. Nízke riziko samostatne.</string>
    <string name="browse_algorithm_strong">Silný</string>
    <string name="browse_algorithm_weak">Slabý</string>
    <string name="browse_algorithm_unknown">Neznáma sila</string>
    <string name="browse_algorithm_strong_explanation">%1$s používa SHA-256 alebo silnejší digest. Nie je známy žiadny praktický útok na kolíziu, hoci celková bezpečnosť závisí aj od typu a veľkosti podpisového kľúča.</string>
    <string name="browse_algorithm_sha1_explanation">%1$s používa SHA-1. SHA-1 už nie je odolný voči kolíziám, takže útočník môže vytvoriť rôzne dáta so rovnakým digestom. Nové podpisové certifikáty by mali používať SHA-256 alebo silnejšie.</string>
    <string name="browse_algorithm_md5_explanation">%1$s používa MD5. MD5 nie je odolný voči kolíziám a je nebezpečný pre podpisové certifikáty. Nové podpisové certifikáty by mali používať SHA-256 alebo silnejšie.</string>
    <string name="browse_algorithm_md2_explanation">%1$s používa MD2. MD2 je zastaraný a zraniteľný voči praktickým útokom, takže je nebezpečný pre podpisové certifikáty. Nové podpisové certifikáty by mali používať SHA-256 alebo silnejšie.</string>
    <string name="browse_algorithm_unknown_explanation">Silu %1$s nemožno posúdiť z jeho názvu algoritmu. Typ a veľkosť kľúča môžu tiež ovplyvniť jeho bezpečnosť.</string>
    <string name="browse_certificate_self_signed">Self-signed</string>
    <string name="browse_certificate_self_signed_explanation">Self-signed certifikáty sú bežné pre Android aplikácie. Porovnajte odtlačok certifikátu s dôveryhodným zdrojom, keď potrebujete overiť vydavateľa.</string>
