    <string name="browse_protection_level_dangerous_explanation">Potřebuje vaše výslovné schválení, než může aplikace toto použít.</string>
    <string name="browse_protection_level_signature_explanation">Pouze aplikace podepsané stejným klíčem jako aplikace, která to deklarovala, mohou toto držet.</string>
    <string name="browse_protection_level_internal_explanation">Vyhrazeno pro systém a přiděleno interními pravidly spíše než vámi.</string>
    <string name="browse_protection_level_normal_explanation">Obvykle uděleno automaticky při instalaci. Nízké riziko samo o sobě.</string>
    <string name="browse_algorithm_strong">Silný</string>
    <string name="browse_algorithm_weak">Slabý</string>
    <string name="browse_algorithm_unknown">Neznámá síla</string>
    <string name="browse_algorithm_strong_explanation">%1$s používá SHA-256 nebo silnější hash. Žádný praktický útok na kolize není znám, i když celková bezpečnost také závisí na typu a velikosti podpisového klíče.</string>
    <string name="browse_algorithm_sha1_explanation">%1$s používá SHA-1. SHA-1 již není odolný vůči kolizím, takže útočník může vytvořit různá data se stejným hashem. Nové podpisové certifikáty by měly používat SHA-256 nebo silnější.</string>
    <string name="browse_algorithm_md5_explanation">%1$s používá MD5. MD5 není odolný vůči kolizím a je nebezpečný pro podpisové certifikáty. Nové podpisové certifikáty by měly používat SHA-256 nebo silnější.</string>
    <string name="browse_algorithm_md2_explanation">%1$s používá MD2. MD2 je zastaralý a zranitelný vůči praktickým útokům, takže je nebezpečný pro podpisové certifikáty. Nové podpisové certifikáty by měly používat SHA-256 nebo silnější.</string>
    <string name="browse_algorithm_unknown_explanation">Sílu %1$s nelze posoudit podle názvu jeho algoritmu. Typ a velikost klíče mohou také ovlivnit jeho bezpečnost.</string>
    <string name="browse_certificate_self_signed">Samo-podepsáno</string>
    <string name="browse_certificate_self_signed_explanation">Samo-podepsané certifikáty jsou normální pro Android aplikace. Porovnejte otisk certifikátu s důvěryhodným zdrojem, když potřebujete ověřit vydavatele.</string>
