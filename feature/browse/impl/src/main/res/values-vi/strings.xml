    <string name="browse_protection_level_dangerous_explanation">Cần sự chấp thuận rõ ràng của bạn trước khi một ứng dụng có thể sử dụng nó.</string>
    <string name="browse_protection_level_signature_explanation">Chỉ các ứng dụng được ký bằng cùng một khóa như ứng dụng đã khai báo mới có thể giữ điều này.</string>
    <string name="browse_protection_level_internal_explanation">Dành riêng cho hệ thống và được cấp theo các quy tắc nội bộ chứ không phải bởi bạn.</string>
    <string name="browse_protection_level_normal_explanation">Thường được cấp tự động khi cài đặt. Bản thân nó có rủi ro thấp.</string>
    <string name="browse_algorithm_strong">Mạnh</string>
    <string name="browse_algorithm_weak">Yếu</string>
    <string name="browse_algorithm_unknown">Sức mạnh không xác định</string>
    <string name="browse_algorithm_strong_explanation">%1$s sử dụng SHA-256 hoặc một hàm băm mạnh hơn. Không có cuộc tấn công va chạm thực tiễn nào được biết đến, mặc dù độ bảo mật tổng thể cũng phụ thuộc vào loại và kích thước khóa ký.</string>
    <string name="browse_algorithm_sha1_explanation">%1$s sử dụng SHA-1. SHA-1 không còn kháng va chạm, vì vậy một kẻ tấn công có thể tạo ra dữ liệu khác nhau với cùng một hàm băm. Các chứng chỉ ký mới nên sử dụng SHA-256 hoặc mạnh hơn.</string>
    <string name="browse_algorithm_md5_explanation">%1$s sử dụng MD5. MD5 không kháng va chạm và không an toàn cho các chứng chỉ ký. Các chứng chỉ ký mới nên sử dụng SHA-256 hoặc mạnh hơn.</string>
    <string name="browse_algorithm_md2_explanation">%1$s sử dụng MD2. MD2 đã lỗi thời và dễ bị tấn công thực tiễn, vì vậy nó không an toàn cho các chứng chỉ ký. Các chứng chỉ ký mới nên sử dụng SHA-256 hoặc mạnh hơn.</string>
    <string name="browse_algorithm_unknown_explanation">Sức mạnh của %1$s không thể được đánh giá từ tên thuật toán của nó. Loại và kích thước khóa cũng có thể ảnh hưởng đến độ bảo mật của nó.</string>
    <string name="browse_certificate_self_signed">Tự ký</string>
    <string name="browse_certificate_self_signed_explanation">Chứng chỉ tự ký là bình thường cho các ứng dụng Android. So sánh dấu vân tay chứng chỉ với một nguồn đáng tin cậy khi bạn cần xác minh nhà phát hành.</string>
