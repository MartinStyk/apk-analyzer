    <!-- General Info: Rationale Descriptions -->
    <string name="general_info_rationale_application_name">The user-visible label of the app, as shown on the home screen and in the app drawer.</string>
    <string name="general_info_rationale_package_name">The unique identifier for this app on the device. No two apps can share the same package name.</string>
    <string name="general_info_rationale_process_name">The name of the operating system process the app runs in. By default, it matches the package name.</string>
    <string name="general_info_rationale_uid">The unique identifier assigned to this app by the Android system. It determines the app\'s access to system resources and file permissions.</string>
    <string name="general_info_rationale_description">An optional summary provided by the app developer in the manifest.</string>
    <string name="general_info_rationale_version_name">The human-readable version string displayed to users, such as \"2.5.1\" or \"Beta 3\".</string>
    <string name="general_info_rationale_version_code">An internal integer that increases with every release. The system uses it to determine whether one version is newer than another.</string>
    <string name="general_info_rationale_min_sdk">The lowest Android API level this app supports. Devices running an older version cannot install it.</string>
    <string name="general_info_rationale_target_sdk">The API level the app was designed and tested for. It tells the system which compatibility behaviors to apply.</string>
    <string name="general_info_rationale_app_type">Whether the app is a pre-installed system app or a user-installed app. System apps have elevated privileges and cannot be fully uninstalled.</string>
    <string name="general_info_rationale_install_source">Where the app was installed from — Google Play, another store, or sideloaded manually.</string>
    <string name="general_info_rationale_installer_package">The package name of the app that performed the installation, such as \"com.android.vending\" for Google Play.</string>
    <string name="general_info_rationale_first_installed">The date and time this app was first installed on the device.</string>
    <string name="general_info_rationale_last_updated">The date and time of the most recent update to this app.</string>
    <string name="general_info_rationale_last_used">The approximate date and time this app was last opened by the user.</string>
    <string name="general_info_rationale_apk_directory">The file system path where the APK file is stored on the device.</string>
    <string name="general_info_rationale_data_directory">The file system path where the app stores its private data, databases, and shared preferences.</string>
    <string name="general_info_rationale_install_location">The preferred storage location declared by the developer — internal storage, external storage, or automatic.</string>
    <string name="general_info_rationale_apk_size">The size of the APK file on disk, excluding app data, caches, and runtime-generated files.</string>
    <string name="general_info_rationale_total_size">The combined size of the APK, app data, and cached files. Requires usage access permission.</string>
